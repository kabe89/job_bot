# ==============================================================================
# JobBot Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to `.env` and fill in your private API keys and credentials.
# Note: You can also configure non-secret settings centrally in `config.yaml`.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Provider Selection & Fallback Cascade
# ------------------------------------------------------------------------------
# Provider order: ollama (local, offline, free) | claude | gemini | auto
# "auto" uses Claude if key is present, then Gemini, then local Ollama.
AI_PROVIDER=ollama

# --- Local Ollama (Primary Offline Inference - Zero Cost & Zero PII Leakage) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.5:latest
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=300
OLLAMA_NUM_CTX=16384
OLLAMA_NUM_PREDICT=4096
OLLAMA_THINK=false
OLLAMA_REFINE_ROUNDS=2
OLLAMA_REFINE_TARGET_SCORE=0.90
OLLAMA_AUTOSTART=true
OLLAMA_AUTOSTART_PULL=true

# --- Anthropic Claude (Optional Cloud Provider) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8
CLAUDE_FALLBACK_MODEL=claude-sonnet-4-6
CLAUDE_EFFORT=high
CLAUDE_MAX_TOKENS=16000

# --- Google Gemini (Optional Cloud Provider) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_CHAIN=gemini-2.5-flash,gemini-3.1-flash-lite-preview
GEMINI_SKIP_ON_ERROR=true

# ------------------------------------------------------------------------------
# 2. Candidate Identity & Profile
# ------------------------------------------------------------------------------
APPLICANT_NAME=Jane Doe
APPLICANT_TITLE=Senior Software Engineer / Computational Scientist
APPLICANT_LOCATION=Boston, MA
APPLICANT_PHONE=+1-555-555-0199
APPLICANT_EMAIL=jane.doe@example.com
APPLICANT_LINKEDIN=https://linkedin.com/in/janedoe-example
APPLICANT_GITHUB=https://github.com/janedoe-example
APPLICANT_PORTFOLIO=https://orcid.org/0000-0002-1825-0097

# ------------------------------------------------------------------------------
# 3. Search & Ingestion Settings
# ------------------------------------------------------------------------------
SEARCH_KEYWORDS=software engineer,computational scientist,data engineer,machine learning
SEARCH_LOCATIONS=Boston, MA,Cambridge, MA,New York, NY,remote,hybrid
SEARCH_EXCLUDE=intern,undergraduate,sales,marketing,recruiter
SEARCH_EXCLUDE_TITLE=freelance,contractor,1099,gig work
MIN_MATCH_SCORE=0.35
SEMANTIC_RANKING_ENABLED=true
RERANK_ENABLED=true
RERANK_TOP_K=20

# ------------------------------------------------------------------------------
# 4. Standard Screening Questions (Auto-Fill Defaults)
# ------------------------------------------------------------------------------
WORK_AUTHORIZED=Yes
REQUIRES_SPONSORSHIP=No
SALARY_EXPECTATION=Open to discussion
EARLIEST_START_DATE=Two weeks from offer
WILLING_ONSITE=Yes
WILLING_RELOCATE=Open to discussion
HOW_HEARD=Company careers site
ANSWER_BANK_PATH=data/answer_bank.json
APPLY_FETCH_TIMEOUT=30

# ------------------------------------------------------------------------------
# 5. ⚠️ Auto-Apply Engine (EXPERIMENTAL / UNDER ACTIVE DEVELOPMENT)
# ------------------------------------------------------------------------------
# WARNING: Automated form submission is under active development.
# Always review applications in headed browser mode before submitting.
AUTO_APPLY=false
BROWSER_APPLY_AUTOSUBMIT=false
PLAYWRIGHT_HEADED=true
APPLY_RATE_LIMIT_PER_DAY=25
WEB_APPLY_DECISION_TIMEOUT=900

# ------------------------------------------------------------------------------
# 6. Networking & Contact Discovery
# ------------------------------------------------------------------------------
CONTACTS_MAX_PER_JOB=3
CONTACTS_AUTOFIND=true
AUTO_PREFETCH_CONTACTS=0
# Optional Google Custom Search API for LinkedIn contact lookups (free tier)
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# ------------------------------------------------------------------------------
# 7. Email Notifications (Optional SMTP Digest)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=JobBot
DIGEST_EMAIL_TO=

# ------------------------------------------------------------------------------
# 8. Web Dashboard
# ------------------------------------------------------------------------------
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5000
DASHBOARD_SECRET=change-this-secret-for-production
